# ==============================================================================
# Terms of Service Red-Flag Scanner & Clause Relationship Analyzer
# Environment Configuration Template
# ==============================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Generative AI (Google Gemini API - Official google-genai SDK)
# Execution behavior:
# 1. GEMINI_MOCK_MODE=true  -> Mock Gemini service (no API key required, offline development/testing)
# 2. GEMINI_MOCK_MODE=false + valid GEMINI_API_KEY -> Real Gemini API
# 3. GEMINI_MOCK_MODE=false + missing API key     -> Clear llm_unavailable error (never silently mocks)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_MOCK_MODE=false

# NLP & Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval Configuration
RETRIEVAL_SIMILARITY_THRESHOLD=0.35
TOP_K=5
RETRIEVAL_TOP_K=5

# Vector Store Directory
VECTOR_STORE_DIR=./data/vector_store

# Clause Classification Thresholds (Model confidence scores, not legal probabilities)
CATEGORY_CONFIDENCE_THRESHOLD=0.32
SECONDARY_CATEGORY_THRESHOLD=0.28

# Attention Detection Thresholds (Deterministic indicator counts)
ATTENTION_HIGH_THRESHOLD=2
ATTENTION_MEDIUM_THRESHOLD=1

# Cross-Clause Relationship Analysis Configuration
RELATIONSHIP_SEMANTIC_THRESHOLD=0.55
MAX_CANDIDATE_PAIRS_PER_CLAUSE=10
MAX_TOTAL_CANDIDATE_PAIRS=500
RELATIONSHIP_MIN_CONFIDENCE=0.50
